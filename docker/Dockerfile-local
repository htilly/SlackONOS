# Use the same Node major as the release image; node:26-slim does not publish linux/arm/v7.
# The --platform flag is used here to make sure we use a multi-platform base image.
FROM --platform=$BUILDPLATFORM node:22-slim AS base

# System deps needed by startup diagnostics and optional dependencies.
RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

# Set the working directory for your application. It is owned by the
# unprivileged "node" user, who installs the dependencies and owns the source,
# so the app and dev tooling (tests, coverage output) run without root.
WORKDIR /app
RUN chown node:node /app
USER node

# Copy package.json and package-lock.json first to leverage Docker cache
COPY --chown=node:node package*.json ./

# Install application dependencies reproducibly, including dev dependencies
RUN npm ci --verbose && npm cache clean --force

# Copy the rest of your application files (see Dockerfile-local.dockerignore allowlist)
COPY --chown=node:node . .

# SlackONOS serves HTTP redirects/TTS on 8080 and HTTPS UI/API on 8443.
EXPOSE 8080 8443

# Same as the release image: start as root only long enough to take ownership
# of the mounted config volume, then drop to "node" (or PUID/PGID).
USER root
COPY docker/entrypoint.sh /usr/local/bin/slackonos-entrypoint.sh
RUN chmod 755 /usr/local/bin/slackonos-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/slackonos-entrypoint.sh"]

# Command to run the application
CMD ["node", "index.js"]
