# Use the official Node.js image based on Alpine Linux
# The --platform flag is used here to make sure we use a multi-platform base image
FROM --platform=$BUILDPLATFORM node:22-slim AS base

# System deps needed by startup diagnostics and optional dependencies.
RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

# Clear npm cache to reduce image size and avoid potential issues
RUN npm cache clean --force

# Set the working directory for your application
WORKDIR /app

# Copy package.json and package-lock.json first to leverage Docker cache
COPY package*.json ./

# Install application dependencies reproducibly, including dev dependencies
RUN npm ci --verbose

# Copy the rest of your application files
COPY . .

# Ensure proper permissions (if needed, adjust as necessary)
RUN chmod -R 755 /app

# SlackONOS serves HTTP redirects/TTS on 8080 and HTTPS UI/API on 8443.
EXPOSE 8080 8443

# Command to run the application
CMD ["node", "index.js"]
